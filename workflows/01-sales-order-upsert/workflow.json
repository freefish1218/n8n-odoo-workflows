{
  "id": "998d49b5-c11a-51f9-9576-190dc3583146",
  "name": "Odoo \u00b7 Idempotent Sales Order Upsert",
  "nodes": [
    {
      "parameters": {
        "content": "## Odoo sales-order upsert\nReceives a normalized paid order, validates it, finds the customer and existing order by `client_order_ref`, then creates or updates the Odoo sales order. The external reference is the idempotency key.\n\nAttach one Odoo API credential to the four Odoo nodes. Test in a staging database first.",
        "height": 300,
        "width": 420,
        "color": 7
      },
      "id": "f185f62f-5325-5177-abc9-19230bcac0b2",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -900,
        -300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "odoo-sales-order-upsert",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "f6ac860a-0423-5910-9a8a-d2f3e6092164",
      "name": "Paid order webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x = $json.body ?? $json;\nfor (const k of ['external_id','customer_email','total']) { if (!x[k]) throw new Error(`Missing ${k}`); }\nreturn [{json:{external_id:String(x.external_id), customer_email:String(x.customer_email).trim().toLowerCase(), customer_name:x.customer_name || x.customer_email, total:Number(x.total), currency:x.currency || 'USD', order_date:x.order_date || new Date().toISOString(), source_payload:x}}];"
      },
      "id": "f24c2538-e752-5848-a75f-6ac6b107916a",
      "name": "Validate and normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "odooApiKeyApi",
        "resource": "custom",
        "operation": "getAll",
        "customResource": {
          "__rl": true,
          "value": "res.partner",
          "mode": "list",
          "cachedResultName": "res.partner"
        },
        "returnAll": false,
        "limit": 1,
        "options": {
          "fieldsList": "id,name,email"
        },
        "filters": {
          "filter": [
            {
              "fieldName": "email",
              "operator": "equal",
              "value": "={{ $json.customer_email }}"
            }
          ]
        }
      },
      "id": "b388f9d1-3e36-59d6-b5d4-8a0cf8cb0e10",
      "name": "Find Odoo customer",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [
        -250,
        -120
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "48317958-e4d8-537a-af0f-1998a314493c",
      "name": "Customer found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -20,
        -120
      ]
    },
    {
      "parameters": {
        "authentication": "odooApiKeyApi",
        "resource": "custom",
        "operation": "create",
        "customResource": {
          "__rl": true,
          "value": "res.partner",
          "mode": "list",
          "cachedResultName": "res.partner"
        },
        "fieldsToSend": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $('Validate and normalize').item.json.customer_name }}",
            "email": "={{ $('Validate and normalize').item.json.customer_email }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "a9095aff-7498-5fa7-82be-8bfc0c56c963",
      "name": "Create Odoo customer",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [
        -20,
        100
      ]
    },
    {
      "parameters": {
        "authentication": "odooApiKeyApi",
        "resource": "custom",
        "operation": "getAll",
        "customResource": {
          "__rl": true,
          "value": "sale.order",
          "mode": "list",
          "cachedResultName": "sale.order"
        },
        "returnAll": false,
        "limit": 1,
        "options": {
          "fieldsList": "id,name,client_order_ref,amount_total,state"
        },
        "filters": {
          "filter": [
            {
              "fieldName": "client_order_ref",
              "operator": "equal",
              "value": "={{ $('Validate and normalize').item.json.external_id }}"
            }
          ]
        }
      },
      "id": "1769e81c-b6d9-5291-b548-6f8feb1ba565",
      "name": "Find order by external ref",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.existing_order_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "cbbb6602-945f-5287-bb23-37c5bedaecf8",
      "name": "Order exists?",
