      "position": [
        700,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "odooApiKeyApi",
        "resource": "custom",
        "operation": "update",
        "customResource": {
          "__rl": true,
          "value": "sale.order",
          "mode": "list",
          "cachedResultName": "sale.order"
        },
        "recordId": {
          "__rl": true,
          "value": "={{ $json.existing_order_id }}",
          "mode": "id"
        },
        "fieldsToSend": {
          "mappingMode": "defineBelow",
          "value": {
            "note": "=Synced by n8n at {{ $now.toISO() }}; source total {{ $('Validate and normalize').item.json.total }} {{ $('Validate and normalize').item.json.currency }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "3621aa76-f747-59ba-8997-4892f6dee988",
      "name": "Update existing order",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [
        940,
        -120
      ]
    },
    {
      "parameters": {
        "authentication": "odooApiKeyApi",
        "resource": "custom",
        "operation": "create",
        "customResource": {
          "__rl": true,
          "value": "sale.order",
          "mode": "list",
          "cachedResultName": "sale.order"
        },
        "fieldsToSend": {
          "mappingMode": "defineBelow",
          "value": {
            "partner_id": "={{ $json.partner_id }}",
            "client_order_ref": "={{ $json.external_id }}",
            "date_order": "={{ $json.order_date.slice(0,19).replace('T',' ') }}",
            "note": "=Imported by n8n. Source total: {{ $json.total }} {{ $json.currency }}. Add product-line mapping for your catalog before production."
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "id": "dcd7d68d-1b38-50f2-a1f1-f1695b2d9282",
      "name": "Create draft order",
      "type": "n8n-nodes-base.odoo",
      "typeVersion": 2,
      "position": [
        940,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const input=$input.first().json; const ctx=$('Attach order context').item.json; return [{json:{ok:true,odoo_id:input.id,external_id:ctx.external_id,action:ctx.existing_order_id?'updated':'created',processed_at:new Date().toISOString()}}];"
      },
      "id": "de2ff3e6-0f1c-5166-bf29-fbf22974ef5d",
      "name": "Return audit result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const base=$('Validate and normalize').item.json; if(!$json.id) throw new Error('Odoo customer id missing'); return [{json:{...base,partner_id:$json.id}}];"
      },
      "id": "388ec96d-366c-555e-a91e-d6c80a6298bb",
      "name": "Use customer context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const base=$('Use customer context').item.json; return [{json:{...base,existing_order_id:$json.id||null,existing_order_name:$json.name||null}}];"
      },
      "id": "2f92aea7-7d31-5afe-9e1e-40ff2e5799cd",
      "name": "Attach order context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
