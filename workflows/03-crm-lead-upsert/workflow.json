          "mode": "list",
          "cachedResultName": "res.partner"
        },
        "returnAll": false,
        "limit": 1,
        "options": {
          "fieldsList": "id,name,email,phone"
        },
        "filters": {
          "filter": [
            {
              "fieldName": "email",
              "operator": "equal",
              "value": "={{ $json.email }}"
            }
          ]
        }
      },
