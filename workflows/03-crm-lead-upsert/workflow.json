    {
      "parameters": {
        "jsCode": "const x=$json.body ?? $json;\nconst email=String(x.email||'').trim().toLowerCase();\nif(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) throw new Error('Valid email required');\nconst name=String(x.name||'').trim(); if(!name) throw new Error('Name required');\nreturn [{json:{name,email,phone:String(x.phone||''),company:String(x.company||''),need:String(x.need||'General enquiry').slice(0,500),source:String(x.source||'website').slice(0,80)}}];"
      },
      "id": "06adc5a2-d45e-568a-8334-7cd548a76ba1",
